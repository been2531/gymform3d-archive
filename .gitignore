# rig3d pipeline (Routinizer v2): work dirs + caches, never committed (results/ is)
output/_rig3d/
_cache_rig3d/

# third-party base-model search downloads (never commit binaries)
output/_basemodels/

# third-party outfit candidate downloads (never commit binaries)
output/_assets/
output/outfit_candidates_v1.png

# cutaway reels: renders, generated anatomy images, QA packages (never committed)
output/cutaway/
cutaway/models/

# autoreel pipeline (daily_run.py / publish_run.py): state, logs, test + validation renders.
# NOTE: output/autoreel/<date>/*.mp4 + *_cover.jpg are NOT ignored on purpose: ig_publish.py hosts them via git push.
output/autoreel/state.json
output/autoreel/logs/
output/autoreel/_*/
output/autoreel/.*.lock
output/autoreel/*/_tts_cache/
output/autoreel/*/*_qa.json
output/pilots/

